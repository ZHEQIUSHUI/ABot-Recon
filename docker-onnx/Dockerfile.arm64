# ABot-Recon 建图服务 — torch-free ONNX 版 (arm64/GB10)。
# ubuntu 24.04 → Python 3.12:onnxruntime-gpu 的 aarch64 轮子只发新 Python(cp310 没有),
# 这也是踢掉 open3d(仅有 py<=3.11 aarch64 轮)换 numpy 实现(miniply.py)的原因。
# CUDA EP 库走 pip 的 cudnn/cublas 轮子;GB10 上初始化失败会自动回退 CPU EP。
FROM docker.m.daocloud.io/library/ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1
# ports.ubuntu.com 从 spark 拉取会挂死 → 换 aliyun 的 ubuntu-ports 镜像(24.04 deb822 格式)
RUN sed -i 's|http://ports.ubuntu.com/ubuntu-ports|http://mirrors.aliyun.com/ubuntu-ports|g' \
        /etc/apt/sources.list.d/ubuntu.sources && \
    apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip libgl1 libglib2.0-0 ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/local/bin/python

WORKDIR /app/docker-onnx
COPY docker-onnx/requirements.arm64.txt /tmp/req.txt
RUN pip3 install -r /tmp/req.txt --extra-index-url https://pypi.nvidia.com

# CUDA EP 找 cudnn/cublas:指向 pip 轮子的 lib 目录(容器由 --gpus all 注入驱动)
ENV LD_LIBRARY_PATH=/usr/local/lib/python3.12/dist-packages/nvidia/cudnn/lib:/usr/local/lib/python3.12/dist-packages/nvidia/cublas/lib:/usr/local/lib/python3.12/dist-packages/nvidia/cufft/lib:/usr/local/lib/python3.12/dist-packages/nvidia/curand/lib:/usr/local/lib/python3.12/dist-packages/nvidia/cuda_runtime/lib:/usr/local/lib/python3.12/dist-packages/nvidia/cuda_nvrtc/lib:/usr/local/lib/python3.12/dist-packages/nvidia/nvjitlink/lib
ENV NVIDIA_VISIBLE_DEVICES=all NVIDIA_DRIVER_CAPABILITIES=compute,utility

COPY docker-onnx/ /app/docker-onnx/

EXPOSE 8000 8080
ENTRYPOINT ["bash", "/app/docker-onnx/entrypoint.sh"]
